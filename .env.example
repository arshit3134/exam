# PORT: The HTTP port the server listens on (defaults to 3000)
PORT=3000

# NODE_ENV: 'development' or 'production'
NODE_ENV=development

# NOTE: NO EXTERNAL DATABASE REQUIRED!
# Data is saved automatically in `data/store.json` on the server.
# No MongoDB installation or Atlas connection needed.

# JWT_SECRET: Strong secret for signing JSON Web Tokens
JWT_SECRET="apex_super_secure_jwt_secret_key_prod_2026_exam_platform"
JWT_EXPIRES_IN="7d"

# CLIENT_URL: Client origin for CORS when frontend and backend are hosted separately
CLIENT_URL="http://localhost:3000"

# GEMINI_API_KEY: Optional Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
